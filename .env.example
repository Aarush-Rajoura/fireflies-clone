# Copy the backend part to backend/.env (Settings reads backend/.env, wherever you
# run from):   cp .env.example backend/.env
# BACKEND_URL is a frontend setting: put it in frontend/.env.local
# locally, or in the Vercel project's environment variables in production.

# ---- Backend (backend/.env) ----
DATABASE_URL=sqlite:///./fireflies.db
# wal | delete  (use delete when the DB file sits on a network share, e.g. PythonAnywhere)
SQLITE_JOURNAL_MODE=wal
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# mock | gemini  (gemini falls back to the mock on any provider error)
AI_PROVIDER=mock
AI_API_KEY=
# Blank = the built-in default (DEFAULT_GEMINI_MODEL in app/ai/llm.py).
AI_MODEL=
AI_RATE_LIMIT=10/minute
MEDIA_DIR=./media
MAX_UPLOAD_MB=10
# Blank = seed dates relative to today; set an ISO date for a fixed, reproducible demo.
SEED_ANCHOR_DATE=
LOG_LEVEL=INFO

# ---- Frontend (frontend/.env.local or Vercel) ----
# Server-side target for the Next.js /api rewrite (the browser never calls the API directly)
BACKEND_URL=http://localhost:8000
